{
  "name": "screenvision",
  "version": "0.1.0",
  "description": "Code-aware browser automation with semantic targeting",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "install-browsers": "node scripts/install-browsers.js",
    "test:e2e": "tsx bin/screenvision.mjs test tests/fixtures",
    "mcp": "node bin/screenvision-mcp.mjs"
  },
  "dependencies": {
    "glob": "^10.3.0",
    "mime-types": "^2.1.35",
    "sharp": "^0.33.0",
    "tree-sitter": "^0.21.0",
    "tree-sitter-html": "^0.20.4",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "playwright": "^1.63.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "bin": {
    "screenvision": "bin/screenvision.mjs",
    "screenvision-mcp": "bin/screenvision-mcp.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "docs"
  ]
}
