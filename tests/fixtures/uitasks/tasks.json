{
  "version": 2,
  "note": "Postconditions are written before any candidate exists. Nothing in this file says HOW to do a task \u2014 only what must be true when it is done, and what must not have happened on the way. That second part is what a UI task has and arithmetic does not: a plan can reach the right end state and still be wrong. Reference solutions live in reference_plans.json, deliberately a separate file, so this one can be shown to a model without showing it the answers. `readyWhen` names the selectors meaning the application has finished loading; scoring a plan against a half-assembled page would measure the fixture's timing rather than the candidate's reasoning.",
  "tasks": [
    {
      "id": "ui-edit-amount",
      "page": "realapp",
      "goal": "Open the edit dialog for invoice INV-1001, change its amount to 250, and save.",
      "referenceSteps": 3,
      "readyWhen": [
        "#inv-body tr",
        "#cust-list li"
      ],
      "postcondition": [
        {
          "textIn": {
            "selector": "#inv-log",
            "contains": "Updated INV-1001"
          }
        },
        {
          "textIn": {
            "selector": "tr[data-inv='INV-1001']",
            "contains": "250"
          }
        },
        {
          "present": {
            "selector": "#modal-backdrop[hidden]"
          }
        }
      ],
      "forbidden": {
        "textAbsent": [
          "Deleted INV-1001"
        ]
      }
    },
    {
      "id": "ui-filter-then-count",
      "page": "realapp",
      "goal": "Filter the customer list so that only Orbital Freight is shown.",
      "referenceSteps": 1,
      "readyWhen": [
        "#inv-body tr",
        "#cust-list li"
      ],
      "postcondition": [
        {
          "countOf": {
            "selector": "#cust-list li",
            "equals": 1
          }
        },
        {
          "textIn": {
            "selector": "#cust-list",
            "contains": "Orbital Freight"
          }
        },
        {
          "textIn": {
            "selector": "#cust-count",
            "contains": "1 of 6"
          }
        }
      ]
    },
    {
